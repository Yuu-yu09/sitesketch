# Secrets — NEVER commit
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Generated sites & exports
published/
exports/

# Database dumps: these contain every account row, never commit them.
# Keep the folder, ignore its contents.
backups/*
!backups/.gitkeep

# Editors / OS
.vscode/
.DS_Store
Thumbs.db

# Installed agent skills (re-installable; lockfile lives at repo root)
.agents/

# Design review captures (regenerated by the screenshot pipeline)
.impeccable/review*/
