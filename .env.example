# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Never paste real secrets into chat, screenshots, or the proposal.

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Supabase Postgres - direct connection string (server-side only)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# Supabase API - project Settings -> API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<service_role_key>

# Google Gemini - https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Auth
JWT_SECRET=<long random string>

# OAuth (optional social sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Flask session signing (only if not using JWT)
SECRET_KEY=
FLASK_DEBUG=1