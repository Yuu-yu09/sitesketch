# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Never paste real secrets into chat, screenshots, or the proposal.

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Supabase Postgres - direct connection string (server-side only)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# Supabase API - project Settings -> API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<service_role_key>

# Google Gemini - https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Auth
JWT_SECRET=<long random string>

# Email, for password resets - https://resend.com/api-keys
# Free tier is 3,000 messages a month, which is far more than this app sends.
# Empty is a working app that cannot deliver a reset link: /api/health then
# reports email_configured: false, and the forgot endpoint still answers
# normally (it must not reveal which addresses have accounts), it just does
# not send anything.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend. The default test sender
# only delivers to the Resend account owner's own inbox.
MAIL_FROM=SiteSketch <onboarding@resend.dev>

# OAuth (optional social sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Flask session signing (only if not using JWT)
SECRET_KEY=
FLASK_DEBUG=1